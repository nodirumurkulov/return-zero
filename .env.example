# Copy this file to frontend/.env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# ── Clerk ─────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Redirect URLs after sign-in / sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key for seeding only — server-side, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── LLM (server-side only — never NEXT_PUBLIC_) ───────────────────────────────
# Set one provider key and set LLM_PROVIDER accordingly.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai          # or: anthropic

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SIGNING_SECRET=...     # for verifying inbound button clicks

# ── Site URL ──────────────────────────────────────────────────────────────────
# Vercel sets this automatically in production; use localhost locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

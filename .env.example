# Copy this file to frontend/.env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key — server-only (cron, seed, validators). Never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── LLM (server-side only — never NEXT_PUBLIC_) ───────────────────────────────
# Set one provider key and set LLM_PROVIDER accordingly.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai          # or: anthropic

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SIGNING_SECRET=...     # for verifying inbound button clicks

# ── Site URL ──────────────────────────────────────────────────────────────────
# Vercel sets this automatically in production; use localhost locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Scheduler (optional) ──────────────────────────────────────────────────────
# If set, /api/detect, /api/forecast and /api/recover accept
# Authorization: Bearer $CRON_SECRET (no user session required).
CRON_SECRET=

# ── Playwright E2E (optional, local) ─────────────────────────────────────────
# Used by e2e/global-setup.ts — defaults shown if unset.
# E2E_USER_EMAIL=e2e@resolve.local
# E2E_USER_PASSWORD=e2e-test-password-12
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

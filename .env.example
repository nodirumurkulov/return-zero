# Copy this file to frontend/.env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key — server-only (cron, seed, validators). Never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── LLM (server-side only — never NEXT_PUBLIC_) ───────────────────────────────
# Set one provider key and set LLM_PROVIDER accordingly.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai          # or: anthropic
# OPENAI_MODEL=gpt-5.5       # optional override (default gpt-5.5)
# ANTHROPIC_MODEL=claude-opus-4-5

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SIGNING_SECRET=...     # verifies inbound button clicks + @hugo events
SLACK_BOT_TOKEN=xoxb-...     # bot token for the @hugo assistant (chat:write)
# Optional: pin Slack workspace to one org (uuid). Or set organizations.slack_team_id in DB.
# SLACK_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# ── Site URL ──────────────────────────────────────────────────────────────────
# Vercel sets this automatically in production; use localhost locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Required in production (NODE_ENV=production). When set, /api/detect,
# /api/forecast and /api/recover accept Authorization: Bearer $CRON_SECRET
# without a user session. Unset locally to trigger cron routes while signed in.
CRON_SECRET=

# ── Demo seed account (optional) ──────────────────────────────────────────────
# Server-only credentials for the shared demo org created by `bun run seed`.
# Not used on sign-in/sign-up — connect the mock store at /onboarding instead.
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=change-me

# ── Playwright E2E (optional, local) ─────────────────────────────────────────
# Used by `seed --full --e2e` and Playwright auth — defaults shown if unset.
# E2E_USER_EMAIL=e2e@hugo.local
# E2E_USER_PASSWORD=e2e-test-password-12
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

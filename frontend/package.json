{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:integration",
    "test": "vitest run",
    "test:lib": "vitest run lib",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "db:sync": "supabase db reset && bun run db:types",
    "db:check-types": "bun run db:types && git diff --exit-code lib/supabase/database.types.ts",
    "db:diff": "supabase db diff --use-pg-delta -f",
    "db:schema:sync": "supabase db schema declarative sync --experimental --apply --yes",
    "db:schema:generate": "supabase db schema declarative generate --local --experimental --yes",
    "db:lint": "supabase db lint",
    "db:test:rls": "bun run scripts/test-rls.ts",
    "seed": "bun run scripts/seed.ts",
    "validate:counts": "bun run scripts/validate-counts.ts",
    "validate:metrics": "bun run scripts/validate-metrics.ts",
    "validate": "bun run validate:counts && bun run validate:metrics",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "ai:devtools": "npx @ai-sdk/devtools"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai": "^3.0.68",
    "@better-fetch/fetch": "^1.1.21",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "ai": "^6.0.197",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^0.0.18",
    "@playwright/test": "^1.52.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "happy-dom": "^20.10.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
}
